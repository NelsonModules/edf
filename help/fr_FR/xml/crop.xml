  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[% Garder de la minute deux a la minute cinq.
edf.crop('night.edf', 'clip.edf', 120, 300);]]></example_item_data>
    </example_item>
  </examples>
