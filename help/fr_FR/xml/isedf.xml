    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[if edf.isedf('mystery.dat')
  r = edf.read('mystery.dat');
end]]></example_item_data>
    </example_item>
  </examples>
