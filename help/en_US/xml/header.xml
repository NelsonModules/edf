  <language>en_US</language>
  <keyword>edf.header</keyword>
  <short_description>Read only the header of an EDF, EDF+, BDF or BDF+ file.</short_description>
  <syntax>
    <syntax_item>r = edf.header(file)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>file</param_name>
      <param_description>the path to the file.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>the same neutral struct edf.read returns, but with no samples and no annotations.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>The data block is never touched, so a whole night is read in a few kilobytes and the record count comes from the file size. It is the shorthand for <b>edf.read(file, 'Data', false)</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[r = edf.header('record.edf');
printf('%d signals, %d records\n', r.ns, r.records);]]></example_item_data>
    </example_item>
  </examples>
