  <language>en_US</language>
  <keyword>edf.channeltype</keyword>
  <short_description>Guess the kind of a signal from its label.</short_description>
  <syntax>
    <syntax_item>kind = edf.channeltype(label)</syntax_item>
    <syntax_item>kind = edf.channeltype(label, transducer)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>label</param_name>
      <param_description>the signal label.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>transducer</param_name>
      <param_description>an optional transducer text that refines the guess.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>kind</param_name>
      <param_description>one of 'eeg', 'eog', 'ecg', 'emg', 'resp', 'spo2', 'status' or 'misc'.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>This is a hint from the label text, not a measurement of the signal, so it is deliberately coarse; a domain module refines it. Every signal returned by edf.read already carries it as its kind field.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[edf.channeltype('C3-A2')   % 'eeg'
edf.channeltype('SpO2')    % 'spo2']]></example_item_data>
    </example_item>
  </examples>
