  <language>en_US</language>
  <keyword>edf.convert</keyword>
  <short_description>Convert voltage signals to a target unit.</short_description>
  <syntax>
    <syntax_item>r = edf.convert(source, target)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>source</param_name>
      <param_description>a file path or a struct from edf.read.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>target</param_name>
      <param_description>the target unit: 'V', 'mV', 'uV' or 'nV'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>the struct with every voltage signal scaled to the target unit (data, physical range and unit); a non-voltage signal is left untouched.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>A mixed montage converts only what it can: a signal whose unit is not a voltage in the V family keeps its samples and its unit.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[r = edf.convert('eeg.edf', 'uV');]]></example_item_data>
    </example_item>
  </examples>
