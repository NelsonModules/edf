  <language>en_US</language>
  <keyword>edf.select</keyword>
  <short_description>Write a channel subset to a new file.</short_description>
  <syntax>
    <syntax_item>edf.select(src, dst, which)</syntax_item>
    <syntax_item>info = edf.select(src, dst, which)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>src</param_name>
      <param_description>the source file.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dst</param_name>
      <param_description>the destination file.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>which</param_name>
      <param_description>the signals to keep, by label (a char or cellstr) or by index into the ordinary signals.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>info</param_name>
      <param_description>the edf.write info of the file written.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>The whole recording is kept in time, with its annotations; only the chosen channels are written. It is how a channel is dropped to a new file. To rename channels in place instead, use edf.edit.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[edf.select('full.edf', 'eeg_only.edf', {'C3-A2', 'C4-A1', 'O1-A2'});]]></example_item_data>
    </example_item>
  </examples>
