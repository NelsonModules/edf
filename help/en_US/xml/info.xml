  <language>en_US</language>
  <keyword>edf.info</keyword>
  <short_description>A compact summary of an EDF, EDF+, BDF or BDF+ file.</short_description>
  <syntax>
    <syntax_item>s = edf.info(file)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>file</param_name>
      <param_description>the path to the file.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>s</param_name>
      <param_description>a struct with file, type, patient, recording, startDateTime, records, recordSeconds, seconds, signalCount, labels, units, rates, samples and bytes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Read from the header alone, it is the quick look before a full <b>edf.read</b>: the type, the start of the recording, the number of data records and their length, the total duration and one row per ordinary signal.</p>
  </description>
