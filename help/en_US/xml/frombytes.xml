  <keyword>edf.frombytes</keyword>
  <short_description>Read an EDF or BDF file that is already in memory.</short_description>
  <syntax>
    <syntax_item>r = edf.frombytes(bytes)</syntax_item>
    <syntax_item>r = edf.frombytes(bytes, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>bytes</param_name>
      <param_description>a uint8 vector of the file's bytes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>...</param_name>
      <param_description>any edf.read option (Signals, Annotations, Data, Records, Interval, ...).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>the same neutral struct edf.read returns.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>For data that arrived over a connection or from an archive without ever being a file. Nelson has no in-memory file handle, so the bytes are written to a temporary file, read, and the temporary file removed; nothing is left behind.</p>
  </description>
  <used_function />
