  <keyword>edf.tobytes</keyword>
  <short_description>Write the neutral struct to a byte vector instead of a file.</short_description>
  <syntax>
    <syntax_item>bytes = edf.tobytes(r)</syntax_item>
    <syntax_item>bytes = edf.tobytes(r, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>r</param_name>
      <param_description>the neutral struct to write (see edf.write).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>...</param_name>
      <param_description>any edf.write option (Format, RecordSeconds, Annotations, Margin).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>bytes</param_name>
      <param_description>a uint8 vector of the file's bytes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>For a file that will be sent over a connection or kept in memory rather than saved. Nelson has no in-memory file handle, so the file is written to a temporary file, read back, and the temporary file removed; nothing is left behind.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[bytes = edf.tobytes(r, 'Format', 'BDF+');]]></example_item_data>
    </example_item>
  </examples>
