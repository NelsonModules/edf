  <language>en_US</language>
  <keyword>edf.crop</keyword>
  <short_description>Write a time window of a file to a new file.</short_description>
  <syntax>
    <syntax_item>edf.crop(src, dst, t0, t1)</syntax_item>
    <syntax_item>edf.crop(src, dst, t0, t1, 'Signals', which)</syntax_item>
    <syntax_item>edf.crop(src, dst, t0, t1, 'RecordSeconds', s)</syntax_item>
    <syntax_item>info = edf.crop(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>src</param_name>
      <param_description>the source file.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dst</param_name>
      <param_description>the destination file.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>t0, t1</param_name>
      <param_description>the window in seconds, T1 greater than T0.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>which</param_name>
      <param_description>the signals to keep, by label or by index.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>s</param_name>
      <param_description>the record length of the output; the default is the source's.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>info</param_name>
      <param_description>the edf.write info of the file written.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>The window keeps the source's flavour and its signals' physical ranges, and re-bases the annotations so an onset is measured from the new start. Each signal is cut at its own rate, so signals of different rates stay aligned.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[% Keep minute two to minute five.
edf.crop('night.edf', 'clip.edf', 120, 300);]]></example_item_data>
    </example_item>
  </examples>
